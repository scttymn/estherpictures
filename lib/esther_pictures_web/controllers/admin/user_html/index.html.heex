<Layouts.app flash={@flash} current_scope={@current_scope}>
  <dialog :if={temp_password = Phoenix.Flash.get(@flash, :temp_password)} class="modal" open>
    <div class="modal-box">
      <h3 class="font-bold text-lg">
        Account created for {Phoenix.Flash.get(@flash, :temp_password_email)}
      </h3>
      <p class="py-2 text-sm opacity-70">
        Copy this temporary password and send it to them. It won't be shown again.
        They'll be asked to change it on first login.
      </p>
      <div class="mt-2 flex items-center gap-2">
        <code class="flex-1 rounded bg-base-200 px-3 py-2 font-mono select-all">
          {temp_password}
        </code>
        <button type="button" class="btn btn-primary btn-sm" data-copy={temp_password}>
          Copy
        </button>
      </div>
      <div class="modal-action">
        <form method="dialog">
          <button class="btn">Done</button>
        </form>
      </div>
    </div>
  </dialog>

  <.header>
    Users
    <:subtitle>Editors and administrators with access to this admin.</:subtitle>
    <:actions>
      <.link href={~p"/admin/users/new"} class="btn btn-primary btn-sm">Invite editor</.link>
    </:actions>
  </.header>

  <div class="mt-8 overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th>Email</th>
          <th>Role</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <tr :for={u <- @users}>
          <td class="font-semibold">
            {u.email}
            <span :if={u.id == @current_user.id} class="badge badge-ghost badge-sm ml-1">
              you
            </span>
          </td>
          <td>
            <span class={[
              "badge badge-sm",
              (u.role == "admin" && "badge-primary") || "badge-ghost"
            ]}>
              {u.role}
            </span>
          </td>
          <td class="opacity-70">
            {if u.must_change_password, do: "Pending first login", else: "Active"}
          </td>
          <td class="text-right">
            <.link
              :if={u.id != @current_user.id}
              href={~p"/admin/users/#{u}"}
              method="delete"
              data-confirm={"Remove #{u.email}? This can't be undone."}
              class="btn btn-ghost btn-xs text-error"
            >
              Remove
            </.link>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</Layouts.app>
